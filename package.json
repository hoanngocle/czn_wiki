{
  "name": "czn-wiki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "import:wiki": "node scripts/import-e7bot.mjs",
    "import:character": "node scripts/import-character.mjs",
    "import:partners": "node scripts/import-partners.mjs",
    "audit:assets": "node scripts/audit-reference-assets.mjs",
    "reference:serve": "node scripts/reference-server.mjs",
    "audit:characters": "vitest run tests/unit/character-content.test.ts tests/unit/combatant-catalog.test.ts tests/unit/combatant-decks-complete.test.ts tests/unit/card-videos.test.ts tests/unit/translation-overlay-audit.test.ts tests/unit/combatant-links.test.ts tests/unit/renoa-translation.test.ts",
    "sync:combatants": "node scripts/sync-combatants.mjs",
    "build:combatant-content": "node scripts/analyze-combatant-guides.mjs && node scripts/build-combatant-guides.mjs && node scripts/register-combatant-content.mjs",
    "sync:card-videos": "node scripts/sync-card-videos.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  }
}
